# Copy to .env on the VM and fill in. NEVER committed -- .env is gitignored.
#
# There is currently no .env on the VM at all, which is why the pipeline logs
# "ALPACA_API_KEY/SECRET not set -- pipeline idle" and has never ingested a
# tick. This file exists so the next person does not have to discover that by
# reading container logs.

# --- Alpaca market data (REQUIRED for the pipeline to do anything) -----------
# Without these the pipeline connects to Redis, finds no keys, and sleeps.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex = free tier, one stream. sip = paid, full consolidated tape.
ALPACA_FEED=iex
SYMBOLS=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL,META,SPY

# --- Kafka (OPTIONAL: empty means off) ---------------------------------------
# Adds a durable, replayable copy of every tick without touching the Redis path
# the backends subscribe to. Empty = Redis only, exactly as before.
#
# The external NodePort, because this container runs on the VM rather than in
# the cluster. Becomes tsp-kafka-bootstrap.kafka.svc:9092 once the pipeline
# moves into the cluster.
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=market.trades

# --- code-server -------------------------------------------------------------
# Guards the public IDE endpoint at ide.zemingzhang.com.
CODE_SERVER_PASSWORD=
